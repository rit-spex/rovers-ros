<launch>
	<arg name="protocol_trace" default="0"></arg>
	<arg name="robot_config" default="arm_drivebase"></arg>
	<set_env name="ROVER_PROTOCOL_TRACE" value="$(var protocol_trace)"></set_env>
	<node pkg="can_udp" exec="can_udp_node" name="can_udp"></node>
	<node pkg="xbee_udp" exec="xbee_udp_node" name="xbee_udp"></node>
	<node pkg="basestation" exec="basestation_node" name="basestation"></node>
	<node pkg="basestation" exec="telemetry_uplink_node" name="telemetry_uplink"></node>
	<node pkg="chassis" exec="chassis_node" name="chassis"></node>
	<node pkg="rover_simulation" exec="arm_sim_node" name="arm_sim" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)">
		<param name="randomize_start" value="true"/>
	</node>
	<node pkg="main" exec="master_node" name="master_node"></node>
	<node pkg="rover_simulation" exec="sim_config_node" name="sim_config">
		<param name="config" value="$(var robot_config)"/>
	</node>
	<node pkg="arm" exec="arm_teleop_node" name="arm_teleop" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
	<node pkg="arm" exec="arm_typing_node" name="arm_typing" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
	<node pkg="arm" exec="arm_route_planner_node" name="arm_route_planner" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
	<node pkg="arm" exec="arm_action_driver_node" name="arm_action_driver" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
	<node pkg="arm" exec="arm_master_node" name="arm_master" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
	<node pkg="arm" exec="arm_end_effector_node" name="arm_end_effector" if="$(eval &quot;'$(var robot_config)'=='arm_drivebase'&quot;)"></node>
</launch>
