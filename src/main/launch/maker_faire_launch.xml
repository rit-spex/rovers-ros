<launch>
	<!-- Maker Faire demo startup profile. The normal rover stack is launched
	     unchanged; the simulated wrist/gripper Teensy is added here so
	     main_launch.xml stays free of demo-only nodes. Autoboot uses this
	     through `ros2 launch main maker_faire_launch.xml`. -->
	<include file="$(find-pkg-share main)/main_launch.xml"></include>
	<node pkg="arm" exec="arm_simulated_teensy_node" name="arm_simulated_teensy"></node>
</launch>
