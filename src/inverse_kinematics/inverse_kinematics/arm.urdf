<?xml version="1.0"?>
<robot name="custom_4dof_arm">

  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.1"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.0833" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.1666" radius="0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0.2371 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.4743" radius="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0.2532 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.5064" radius="0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <link name="link4">
    <visual>
      <origin xyz="0.1474 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.2948" radius="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="joint0_base" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415" upper="3.1415" effort="100" velocity="3.0"/>
  </joint>

  <joint name="joint1_shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.1666" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="3.0"/>
  </joint>

  <joint name="joint2_elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.4743 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="100" velocity="3.0"/>
  </joint>

  <joint name="joint3_wrist" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.5064 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="3.0"/>
  </joint>

</robot>