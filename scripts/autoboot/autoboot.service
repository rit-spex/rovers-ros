[Unit]
Description=SPEX rover ROS 2 stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROS_WS@
Environment=HOME=@HOME@
Environment=SHELL=/bin/bash
ExecStart=/bin/bash @ROS_WS@/scripts/autoboot/autoboot.sh @AUTOBOOT_ARGS@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
